DJANGO_SECRET_KEY=replace-with-a-random-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DJANGO_LOG_LEVEL=INFO
POSTGRES_DB=qiaonong_dev
POSTGRES_USER=qiaonong_dev
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 以下路径与安全开关只在生产环境的独立 .env 中启用。
# 开发配置会强制把静态及媒体产物保存在 backend/ 下的 Git 忽略目录。
DJANGO_STATIC_ROOT=/srv/qiaonong/static
DJANGO_MEDIA_ROOT=/srv/qiaonong/media
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
