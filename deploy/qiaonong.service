[Unit]
Description=Qiaonong Django Gunicorn
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=qiaonong
Group=www-data
WorkingDirectory=/srv/qiaonong/app/backend
EnvironmentFile=/srv/qiaonong/app/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=qiaonong
RuntimeDirectoryMode=0750
ExecStart=/srv/qiaonong/venv/bin/gunicorn config.wsgi:application --bind unix:/run/qiaonong/gunicorn.sock --umask 007 --workers 2 --threads 2 --timeout 30 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/qiaonong/media /srv/qiaonong/logs /run/qiaonong

[Install]
WantedBy=multi-user.target
