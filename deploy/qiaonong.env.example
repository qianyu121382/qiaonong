DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=zgqnht.com,www.zgqnht.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://zgqnht.com,https://www.zgqnht.com
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=qiaonong_prod
POSTGRES_USER=qiaonong_app
POSTGRES_PASSWORD=replace-with-an-independent-production-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_STATIC_ROOT=/srv/qiaonong/static
DJANGO_MEDIA_ROOT=/srv/qiaonong/media
FRONTEND_DIST_ROOT=/srv/qiaonong/app/frontend/dist
PUBLIC_SITE_URL=https://zgqnht.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
